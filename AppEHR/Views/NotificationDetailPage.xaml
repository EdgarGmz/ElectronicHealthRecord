<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppEHR.ViewModels"
             x:Class="AppEHR.Views.NotificationDetailPage"
             Title="Detalle de Notificación">

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource GradientStartLight}, Dark={StaticResource GradientStartDark}}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource GradientEndLight}, Dark={StaticResource GradientEndDark}}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView Padding="16">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                
                <!-- Main Glass Card -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}, Default={StaticResource GlassBorderLight}}"
                        Background="{AppThemeBinding Light={StaticResource GlassBgLight}, Dark={StaticResource GlassBgDark}, Default={StaticResource GlassBgLight}}"
                        Padding="20"
                        Margin="0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <!-- Header with priority indicator -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding CurrentNotification.Type, StringFormat='Categoría: {0}'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="Gray"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding CurrentNotification.PriorityColor}"
                                    Padding="8,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="{Binding CurrentNotification.Priority}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </Grid>

                        <!-- Notification Title -->
                        <Label Text="{Binding CurrentNotification.Title}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                        <!-- Metadata (Sender & Date) -->
                        <VerticalStackLayout Spacing="6" Padding="0,4" BackgroundColor="Transparent">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="✉️ De: " FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                <Label Grid.Column="1" 
                                       Text="{Binding CurrentNotification.FromUser.FullName, TargetNullValue='Sistema', FallbackValue='Sistema'}" 
                                       FontSize="12" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" />
                            </Grid>
                            
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="📅 Fecha: " FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                <Label Grid.Column="1" Text="{Binding CurrentNotification.FormattedDate}" FontSize="12" TextColor="Gray" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Separator line -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}, Default={StaticResource Gray200}}" />

                        <!-- Message Body -->
                        <Label Text="{Binding CurrentNotification.Message}"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                               Padding="0,6" />

                    </VerticalStackLayout>
                </Border>

                <!-- Actions buttons layout -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                    <Button Grid.Column="0"
                            Text="✕ Eliminar"
                            Command="{Binding DeleteCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource BrandError}"
                            BorderWidth="1.2"
                            TextColor="{StaticResource BrandError}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46" />
                    
                    <Button Grid.Column="1"
                            Text="Volver"
                            Command="{Binding CloseCommand}"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
