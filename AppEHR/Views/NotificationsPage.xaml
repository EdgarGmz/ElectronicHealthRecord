<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppEHR.ViewModels"
             xmlns:models="clr-namespace:AppEHR.Models"
             xmlns:converters="clr-namespace:AppEHR.Converters"
             x:Class="AppEHR.Views.NotificationsPage"
             x:Name="ThisPage"
             Title="Notificaciones">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource GradientStartLight}, Dark={StaticResource GradientStartDark}}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource GradientEndLight}, Dark={StaticResource GradientEndDark}}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid RowDefinitions="Auto, *">
            
            <!-- Header Row -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="16" VerticalOptions="Center">
                <!-- Summary of pending notifications -->
                <Label Grid.Column="0" 
                       VerticalOptions="Center"
                       FontSize="13" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding UnreadCount}" Value="0">
                            <Setter Property="Text" Value="No tienes notificaciones pendientes" />
                        </DataTrigger>
                        <!-- Dynamic text fallback via binding in code or simple standard label: we can use a binding string format or just bind Text directly -->
                    </Label.Triggers>
                    <Label.Text>
                        <Binding Path="UnreadCount" StringFormat="Tienes {0} notificaciones pendientes" />
                    </Label.Text>
                </Label>

                <!-- Mark all as read button -->
                <Button Grid.Column="1"
                        Text="✓ Marcar todo"
                        Command="{Binding MarkAllAsReadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource BrandPrimary}"
                        FontAttributes="Bold"
                        FontSize="12"
                        Padding="8,4"
                        HeightRequest="32"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Refresh list of notifications -->
            <RefreshView Grid.Row="1" Command="{Binding LoadNotificationsCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Notifications}" SelectionMode="None">
                    
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                            <Label Text="🔔" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="Sin notificaciones" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Gray" />
                            <Label Text="Tu bandeja de entrada está vacía en este momento." FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="Gray" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Notification">
                            <Grid Padding="0,2,0,4">
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                                        Background="{AppThemeBinding Light={StaticResource GlassBgLight}, Dark={StaticResource GlassBgDark}}"
                                        Padding="14"
                                        Margin="16,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <!-- Gesture to view detail when tapped -->
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.NavigateToDetailCommand, Source={x:Reference ThisPage}}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="14, *, Auto" ColumnSpacing="8">
                                        <!-- Column 0: Unread Dot indicator -->
                                        <Ellipse Grid.Column="0" 
                                                 WidthRequest="8"
                                                 HeightRequest="8"
                                                 Fill="{StaticResource BrandPrimary}"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center">
                                            <Ellipse.Triggers>
                                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsRead}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsRead}" Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>

                                        <!-- Column 1: Message contents -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            
                                            <!-- Sender info -->
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="De:" FontSize="10.5" TextColor="Gray" />
                                                <Label Text="{Binding FromUser.FullName, TargetNullValue='Sistema', FallbackValue='Sistema'}" 
                                                       FontSize="10.5" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Message}"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                            
                                            <Label Text="{Binding FormattedDate}"
                                                   FontSize="10"
                                                   TextColor="Gray" />
                                        </VerticalStackLayout>

                                        <!-- Column 2: Delete Button (Red X) -->
                                        <Button Grid.Column="2"
                                                Text="✕"
                                                Command="{Binding BindingContext.DeleteNotificationCommand, Source={x:Reference ThisPage}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#EF4444"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- FAB (Floating Action Button) de Agendado Rápido -->
            <Button Grid.Row="1"
                    Command="{Binding NavigateToQuickAppointmentCommand}"
                    Text="➕"
                    TextColor="White"
                    FontSize="22"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    WidthRequest="56"
                    HeightRequest="56"
                    CornerRadius="28"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.25}" />
        </Grid>
    </Grid>

</ContentPage>
