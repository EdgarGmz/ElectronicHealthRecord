<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppEHR.ViewModels"
             xmlns:models="clr-namespace:AppEHR.Models"
             xmlns:converters="clr-namespace:AppEHR.Converters"
             xmlns:controls="clr-namespace:AppEHR.Controls"
             x:Class="AppEHR.Views.NotificationsPage"
             x:Name="ThisPage"
             Title="Notificaciones">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource GradientStartLight}, Dark={StaticResource GradientStartDark}}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource GradientEndLight}, Dark={StaticResource GradientEndDark}}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid RowDefinitions="Auto, Auto, *" Padding="0" RowSpacing="0">
            
            <!-- 0. Floating Glassmorphic Weather & Profile Header Bar -->
            <Border Grid.Row="0"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                    Background="{AppThemeBinding Light={StaticResource GlassBgLight}, Dark={StaticResource GlassBgDark}}"
                    Padding="14,10"
                    Margin="16,10,16,2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <!-- Left Section: Date, Time & Weather Status -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <!-- Date Info -->
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="📅" FontSize="13" VerticalOptions="Center" />
                            <Label Text="{Binding FormattedDate}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <Label Text="|" TextColor="Gray" FontSize="12" VerticalOptions="Center" />
                        
                        <!-- Time Info -->
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="🕒" FontSize="13" VerticalOptions="Center" />
                            <Label Text="{Binding FormattedTime}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Weather Info (Conditional visibility) -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" IsVisible="{Binding IsWeatherVisible}">
                            <Label Text="|" TextColor="Gray" FontSize="12" VerticalOptions="Center" />
                            <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding WeatherIcon}" FontSize="13" VerticalOptions="Center" />
                                <Label Text="{Binding CurrentTemperatureText}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={DynamicResource BrandPrimary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Right Section: User Profile & Avatar -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                        <Label Text="{Binding PsychologistName}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" VerticalOptions="Center" />
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="{AppThemeBinding Light='#15D35400', Dark='#30D35400'}" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Label Text="{Binding PsychologistInitials}" FontAttributes="Bold" FontSize="11" TextColor="{DynamicResource BrandPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Header Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="16" VerticalOptions="Center">
                <!-- Summary of pending notifications -->
                <Label Grid.Column="0" 
                       VerticalOptions="Center"
                       FontSize="13" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding UnreadCount}" Value="0">
                            <Setter Property="Text" Value="No tienes notificaciones pendientes" />
                        </DataTrigger>
                        <!-- Dynamic text fallback via binding in code or simple standard label: we can use a binding string format or just bind Text directly -->
                    </Label.Triggers>
                    <Label.Text>
                        <Binding Path="UnreadCount" StringFormat="Tienes {0} notificaciones pendientes" />
                    </Label.Text>
                </Label>

                <!-- Mark all as read button -->
                <Button Grid.Column="1"
                        Text="✓ Marcar todo"
                        Command="{Binding MarkAllAsReadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource BrandPrimary}"
                        FontAttributes="Bold"
                        FontSize="12"
                        Padding="8,4"
                        HeightRequest="32"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Refresh list of notifications -->
            <RefreshView Grid.Row="2" Command="{Binding LoadNotificationsCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Notifications}" SelectionMode="None">
                    
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                            <Label Text="🔔" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="Sin notificaciones" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Gray" />
                            <Label Text="Tu bandeja de entrada está vacía en este momento." FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="Gray" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Notification">
                            <Grid Padding="0,2,0,4">
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#30FFFFFF, Dark=#20FFFFFF}"
                                        Background="{AppThemeBinding Light=#90FFFFFF, Dark=#50161622}"
                                        Padding="14"
                                        Margin="16,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <!-- Gesture to view detail when tapped -->
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.NavigateToDetailCommand, Source={x:Reference ThisPage}}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="14, *, Auto" ColumnSpacing="8">
                                        <!-- Column 0: Unread Dot indicator -->
                                        <Ellipse Grid.Column="0" 
                                                 WidthRequest="8"
                                                 HeightRequest="8"
                                                 Fill="{DynamicResource BrandPrimary}"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center">
                                            <Ellipse.Triggers>
                                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsRead}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsRead}" Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>

                                        <!-- Column 1: Message contents -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#212121, Dark=White}" />
                                            
                                            <!-- Sender info -->
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="De:" FontSize="10.5" TextColor="Gray" />
                                                <Label Text="{Binding FromUser.FullName, TargetNullValue='Sistema', FallbackValue='Sistema'}" 
                                                       FontSize="10.5" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#2C2C2C, Dark=#E0E0E0}" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Message}"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   TextColor="{AppThemeBinding Light=#404040, Dark=#ACACAC}" />
                                            
                                            <Label Text="{Binding FormattedDate}"
                                                   FontSize="10"
                                                   TextColor="Gray" />
                                        </VerticalStackLayout>

                                        <!-- Column 2: Delete Button (Red X) -->
                                        <Button Grid.Column="2"
                                                Text="✕"
                                                Command="{Binding BindingContext.DeleteNotificationCommand, Source={x:Reference ThisPage}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#EF4444"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Bottom Navigation Bar -->
            <controls:AppNavBar ActiveTab="3" Grid.Row="2" VerticalOptions="End" Margin="16,0,16,10" />
        </Grid>
    </Grid>

</ContentPage>
