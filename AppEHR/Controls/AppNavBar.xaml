<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppEHR.Controls.AppNavBar"
             x:Name="ThisControl">

    <!-- Container Grid with height 86px to allow top overflow of central button without clipping -->
    <Grid HeightRequest="86" VerticalOptions="End">
        
        <!-- 1. Dock Bar Background (Height 62px, anchored at bottom) -->
        <Border StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                Background="{AppThemeBinding Light={StaticResource GlassBgLight}, Dark={StaticResource GlassBgDark}}"
                HeightRequest="62"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-3" Radius="10" Opacity="0.1" />
            </Border.Shadow>
        </Border>

        <!-- 2. Interactive Items Grid overlaying the Dock Bar -->
        <Grid ColumnDefinitions="*, *, *, *, *" HeightRequest="86" VerticalOptions="End">

            <!-- 1. CALENDARIO TAB (Col 0) -->
            <Grid Grid.Column="0" RowDefinitions="Auto, Auto" RowSpacing="2" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab1Clicked" />
                </Grid.GestureRecognizers>
                <Path x:Name="Tab1Icon"
                      Grid.Row="0"
                      Data="M 5 4 L 19 4 A 2 2 0 0 1 21 6 L 21 20 A 2 2 0 0 1 19 22 L 5 22 A 2 2 0 0 1 3 20 L 3 6 A 2 2 0 0 1 5 4 Z M 16 2 L 16 6 M 8 2 L 8 6 M 3 10 L 21 10"
                      WidthRequest="22"
                      HeightRequest="22"
                      Aspect="Uniform"
                      Fill="Transparent"
                      Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
                <Label Grid.Row="1" Text="Calendario" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" x:Name="Tab1Label" />
            </Grid>

            <!-- 2. CONSULTANTES TAB (Col 1) -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto" RowSpacing="2" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab2Clicked" />
                </Grid.GestureRecognizers>
                <Path x:Name="Tab2Icon"
                      Grid.Row="0"
                      Data="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M 5 7 a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0 Z M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75"
                      WidthRequest="22"
                      HeightRequest="22"
                      Aspect="Uniform"
                      Fill="Transparent"
                      Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
                <Label Grid.Row="1" Text="Consultantes" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" x:Name="Tab2Label" />
            </Grid>

            <!-- 3. CENTRAL PROMINENT ELEVATED AGENDAR CITA BUTTON (Col 2 - No Clipping) -->
            <Grid Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,0,0,0">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <!-- Floating Circular Action Button -->
                    <Border x:Name="CentralBtn"
                            WidthRequest="56"
                            HeightRequest="56"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            StrokeThickness="2.5"
                            Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,4" Radius="10" Opacity="0.45" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCentralQuickApptClicked" />
                        </Border.GestureRecognizers>

                        <Label x:Name="CentralIcon"
                               Text="+" 
                               TextColor="White" 
                               FontSize="26" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Agendar" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- 4. NOTIFICACIONES TAB (Col 3) -->
            <Grid Grid.Column="3" RowDefinitions="Auto, Auto" RowSpacing="2" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab3Clicked" />
                </Grid.GestureRecognizers>
                <Path x:Name="Tab3Icon"
                      Grid.Row="0"
                      Data="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9 M13.73 21a2 2 0 0 1-3.46 0"
                      WidthRequest="22"
                      HeightRequest="22"
                      Aspect="Uniform"
                      Fill="Transparent"
                      Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
                <Label Grid.Row="1" Text="Notificaciones" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" x:Name="Tab3Label" />
            </Grid>

            <!-- 5. AJUSTES TAB (Col 4) -->
            <Grid Grid.Column="4" RowDefinitions="Auto, Auto" RowSpacing="2" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTab4Clicked" />
                </Grid.GestureRecognizers>
                <Path x:Name="Tab4Icon"
                      Grid.Row="0"
                      Data="M 9 12 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0 Z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                      WidthRequest="22"
                      HeightRequest="22"
                      Aspect="Uniform"
                      Fill="Transparent"
                      Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
                <Label Grid.Row="1" Text="Ajustes" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" x:Name="Tab4Label" />
            </Grid>

        </Grid>
    </Grid>

</ContentView>
