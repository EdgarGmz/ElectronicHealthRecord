<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppEHR.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppEHR.Views"
    Title="AppEHR"
    FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False">

    <!-- Login Page Branch -->
    <ShellItem Route="LoginPage" Shell.TabBarIsVisible="False" Shell.NavBarIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </ShellItem>

    <!-- Main Navigation TabBar (4 Tabs) -->
    <TabBar Shell.TabBarIsVisible="False">
        <Tab Title="Calendario" Icon="calendar_tab.png" Route="DashboardTab">
            <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Consultantes" Icon="users_tab.png" Route="PatientsTab">
            <ShellContent Route="PatientsPage" ContentTemplate="{DataTemplate views:PatientsPage}" />
        </Tab>
        <Tab Title="Notificaciones" Icon="bell_tab.png" Route="NotificationsTab">
            <ShellContent Route="NotificationsPage" ContentTemplate="{DataTemplate views:NotificationsPage}" />
        </Tab>
        <Tab Title="Ajustes" Icon="settings_tab.png" Route="SettingsTab">
            <ShellContent Route="SettingsPage" ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
