<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppEHR.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppEHR.Views"
    Title="AppEHR"
    FlyoutBehavior="Disabled">

    <!-- Login Page Branch -->
    <ShellItem Route="LoginPage">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </ShellItem>

    <!-- Main Navigation TabBar -->
    <TabBar>
        <Tab Title="Calendario">
            <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Consultantes">
            <ShellContent Route="PatientsPage" ContentTemplate="{DataTemplate views:PatientsPage}" />
        </Tab>
        <Tab Title="Agendar">
            <ShellContent Route="QuickAppointmentTab" ContentTemplate="{DataTemplate views:QuickAppointmentPage}" />
        </Tab>
        <Tab Title="Notificaciones">
            <ShellContent Route="NotificationsPage" ContentTemplate="{DataTemplate views:NotificationsPage}" />
        </Tab>
    </TabBar>

</Shell>

