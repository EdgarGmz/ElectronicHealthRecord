---
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
---

<Layout title="Agendar Asesoría - UT Care">
    <!-- Canvas de Partículas Flotantes (Antigravedad) -->
    <canvas id="global-antigravity-canvas" class="global-background-canvas"></canvas>

    <header class="navbar">
        <div class="logo">Psicopedagogía</div>
        <nav>
            <a href="/" data-astro-reload class="home-btn">Inicio</a>
            <ThemeToggle />
        </nav>
    </header>

    <main class="booking-page">
        <div class="booking-container">
            <div class="form-header">
                <span class="badge">UT Care Agenda Rápida</span>
                <h1>Agendar Asesoría</h1>
                <p class="booking-subtitle-wrapper">
                    <span id="booking-subtitle"></span>
                </p>
            </div>

            <!-- Alerta visual de error/éxito -->
            <div id="booking-alert" class="status-alert"></div>
            
            <form id="booking-form" class="booking-form">
                <!-- Inputs de Identificación Obligatorios -->
                <div class="input-row">
                    <div class="input-group">
                        <label for="firstName">Nombre(s)</label>
                        <input type="text" id="firstName" name="firstName" placeholder="Juan" required>
                    </div>
                    <div class="input-group">
                        <label for="lastName">Apellido(s)</label>
                        <input type="text" id="lastName" name="lastName" placeholder="Pérez" required>
                    </div>
                </div>

                <!-- Datos obligatorios de edad y carrera -->
                <div class="input-row">
                    <div class="input-group">
                        <label for="edad">Edad</label>
                        <input type="number" id="edad" name="edad" placeholder="20" min="16" max="90" required>
                    </div>
                    <div class="input-group">
                        <label for="carrera">Carrera</label>
                        <div class="select-wrapper">
                            <select id="carrera" name="careerId" required>
                                <option value="" disabled selected>Cargando carreras...</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="input-group">
                    <label for="email">Correo de Contacto</label>
                    <input type="email" id="email" name="email" placeholder="correo@ejemplo.com" required>
                    <p class="helper-text confidential-label">🔒 Confidencial: Solo el especialista asignado lo verá.</p>
                </div>

                <div class="input-group">
                    <label for="phone">Teléfono / WhatsApp</label>
                    <input type="tel" id="phone" name="phone" placeholder="8110000000" pattern="[0-9]{10}" required>
                    <p class="helper-text confidential-label">🔒 Confidencial: Solo el especialista asignado lo verá.</p>
                </div>

                <div class="input-group">
                    <label for="reason">¿Cómo te sientes o cuál es el motivo de tu consulta? (Opcional)</label>
                    <textarea id="reason" name="reason" rows="4" placeholder="Escribe aquí si deseas detallar algo..."></textarea>
                </div>

                <button type="submit" id="book-submit-btn" class="submit-button">
                    <span class="btn-text">Confirmar Cita de Psicología</span>
                    <div class="btn-spinner"></div>
                </button>
            </form>
        </div>
    </main>
</Layout>

<script>
    import { API_BASE_URL } from '../../utils/api';

    // Listado de frases de apoyo y ánimos
    const cheerMessages = [
        "No te preocupes, todos pasamos por malos ratos! ✨",
        "¡No estás solo! Estamos aquí para escucharte. 🤝",
        "Sabemos que no es fácil por lo que estás pasando... ¡pero diste el primer paso! 🌱",
        "Tu bienestar es nuestra prioridad. Hablar sana. ❤️",
        "Cuidar de tu mente también es parte de tu carrera. 🎓",
        "Aquí tienes un espacio seguro y confidencial. 🔒"
    ];

    let currentMessageIndex = Math.floor(Math.random() * cheerMessages.length);

    const setupCheerRotation = () => {
        // Limpiar cualquier intervalo y timeout de rotación previos
        if ((window as any)._cheerTimeout) clearTimeout((window as any)._cheerTimeout);
        if ((window as any)._cheerInterval) clearInterval((window as any)._cheerInterval);

        const subtitleEl = document.getElementById('booking-subtitle');
        if (!subtitleEl) return;

        // Establecer primera frase e iniciar opaco con resplandor
        subtitleEl.textContent = cheerMessages[currentMessageIndex];
        subtitleEl.classList.remove('fade-out');

        // Rotar cada 5 segundos de forma continua
        (window as any)._cheerInterval = setInterval(() => {
            // 1. Iniciar desvanecimiento (Fade Out)
            subtitleEl.classList.add('fade-out');

            // 2. Cambiar frase y volver a desvanecer hacia adentro (Fade In) a los 800ms
            (window as any)._cheerTimeout = setTimeout(() => {
                let nextIndex = Math.floor(Math.random() * cheerMessages.length);
                while (nextIndex === currentMessageIndex) {
                    nextIndex = Math.floor(Math.random() * cheerMessages.length);
                }
                currentMessageIndex = nextIndex;
                subtitleEl.textContent = cheerMessages[currentMessageIndex];
                subtitleEl.classList.remove('fade-out');
            }, 800); // Coincide con la duración de la transición CSS
        }, 5000);
    };

    // --- PARTÍCULAS ANTIGRAVEDAD DE FONDO ---
    const initGlobalParticles = () => {
        const canvas = document.getElementById('global-antigravity-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let width = window.innerWidth;
        let height = window.innerHeight;
        canvas.width = width;
        canvas.height = height;

        let particles: any[] = [];
        const maxParticles = 60;

        const createParticle = (isInitial = false) => {
            return {
                x: Math.random() * width,
                y: isInitial ? Math.random() * height : height + Math.random() * 50,
                radius: Math.random() * 5 + 1.5,
                speedY: -(Math.random() * 0.35 + 0.15),
                speedX: Math.random() * 0.15 - 0.075,
                alpha: Math.random() * 0.25 + 0.08,
                wobble: Math.random() * Math.PI * 2,
                wobbleSpeed: Math.random() * 0.008 + 0.003
            };
        };

        for (let i = 0; i < maxParticles; i++) {
            particles.push(createParticle(true));
        }

        let animationFrameId: number;

        const animate = () => {
            ctx.clearRect(0, 0, width, height);

            const isDark = document.documentElement.classList.contains('dark');
            const particleColor = isDark ? '162, 217, 206' : '44, 62, 80';

            particles.forEach((p, index) => {
                p.y += p.speedY;
                p.wobble += p.wobbleSpeed;
                p.x += p.speedX + Math.sin(p.wobble) * 0.12;

                if (p.y + p.radius < 0) {
                    particles[index] = createParticle(false);
                    return;
                }

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(${particleColor}, ${p.alpha})`;
                ctx.fill();
            });

            animationFrameId = requestAnimationFrame(animate);
        };

        animate();

        const handleResize = () => {
            if (!canvas) return;
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = width;
            canvas.height = height;
        };

        window.addEventListener('resize', handleResize);

        return () => {
            window.removeEventListener('resize', handleResize);
            cancelAnimationFrame(animationFrameId);
        };
    };

    let particlesCleanup: (() => void) | undefined;
    const startParticles = () => {
        if (particlesCleanup) particlesCleanup();
        particlesCleanup = initGlobalParticles();
    };

    const setupBookingForm = async () => {
        // Inicializar rotación de ánimos
        setupCheerRotation();

        // Inicializar partículas de fondo
        startParticles();

        // Elementos
        const carreraSelect = document.getElementById('carrera') as HTMLSelectElement;
        const bookingForm = document.getElementById('booking-form');
        const bookingAlert = document.getElementById('booking-alert');
        const bookingSubmit = document.getElementById('book-submit-btn');

        if (!bookingForm) return;

        // 1. CARGA DINÁMICA DE CARRERAS DE LA API PÚBLICA
        if (carreraSelect) {
            try {
                const response = await fetch(`${API_BASE_URL}/careers`);
                if (!response.ok) throw new Error('Error al cargar carreras');
                
                const data = await response.json();
                const careers = data.data || [];

                carreraSelect.innerHTML = '<option value="" disabled selected>Selecciona tu carrera</option>';
                careers.forEach((career: any) => {
                    if (career.isActive) {
                        const option = document.createElement('option');
                        option.value = career.id; // UUID
                        option.textContent = `${career.code} - ${career.name}`;
                        carreraSelect.appendChild(option);
                    }
                });
            } catch (error) {
                console.error(error);
                carreraSelect.innerHTML = '<option value="" disabled selected>Error al cargar carreras</option>';
            }
        }

        // 2. CAPTURA Y ENVÍO DEL FORMULARIO
        const handleFormSubmit = async (e: Event) => {
            e.preventDefault();
            if (!bookingAlert || !bookingSubmit) return;

            bookingAlert.className = 'status-alert';
            bookingAlert.style.display = 'none';
            bookingAlert.textContent = '';
            bookingSubmit.classList.add('loading');

            const formData = new FormData(bookingForm as HTMLFormElement);
            const firstName = (formData.get('firstName') as string).trim();
            const lastName = (formData.get('lastName') as string).trim();
            const email = formData.get('email') as string;
            const phone = formData.get('phone') as string;
            const careerId = formData.get('careerId') as string;
            const reason = formData.get('reason') as string;
            const age = parseInt(formData.get('edad') as string);

            try {
                const response = await fetch(`${API_BASE_URL}/appointments/queue/join`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        firstName,
                        lastName,
                        email,
                        phone,
                        age,
                        careerId,
                        department: 'psicologia', // Envío fijo del departamento único de citas
                        reason
                    })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || 'Error al registrar tu solicitud');
                }

                // Guardar éxito en sessionStorage
                sessionStorage.setItem('bookingSuccess', 'true');

                bookingAlert.classList.add('success');
                bookingAlert.style.display = 'block';
                bookingAlert.textContent = '¡Tu solicitud ha sido registrada! Redirigiendo...';

                // Detener intervalos y animaciones antes de la redirección
                if ((window as any)._cheerTimeout) clearTimeout((window as any)._cheerTimeout);
                if ((window as any)._cheerInterval) clearInterval((window as any)._cheerInterval);
                if (particlesCleanup) particlesCleanup();

                setTimeout(() => {
                    window.location.href = '/?bookingSuccess=true';
                }, 1500);

            } catch (error: any) {
                console.error(error);
                bookingAlert.classList.add('error');
                bookingAlert.style.display = 'block';
                bookingAlert.textContent = error.message || 'Error de conexión con el servidor.';
                bookingSubmit.classList.remove('loading');
            }
        };

        const newForm = bookingForm.cloneNode(true);
        bookingForm.parentNode?.replaceChild(newForm, bookingForm);
        newForm.addEventListener('submit', handleFormSubmit);
    };

    // Inicializar listeners en carga de página y transiciones ViewTransitions
    document.addEventListener('DOMContentLoaded', setupBookingForm);
    document.addEventListener('astro:after-swap', setupBookingForm);
</script>

<style>
    /* Canvas de fondo global */
    .global-background-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }

    /* Navbar Styles */
    .navbar {
        position: sticky;
        top: 0;
        width: 100%;
        background-color: var(--navbar-bg);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 30px;
        box-sizing: border-box;
        z-index: 1000;
        border-bottom: 1px solid var(--navbar-border);
        height: 70px;
    }

    .logo {
        color: var(--logo-color);
        font-size: 1.5rem;
        font-weight: bold;
        font-family: 'Playfair Display', serif;
    }

    .navbar nav {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .navbar nav a {
        color: var(--nav-link-color);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s;
    }

    .navbar nav a:hover {
        color: var(--nav-link-hover);
    }

    /* Booking Page Styles */
    .booking-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 70px);
        background-color: transparent; /* Permitir ver el canvas de fondo */
        padding: 3rem 1rem;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .booking-container {
        background-color: var(--card-bg);
        padding: 3rem;
        border-radius: 30px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
        width: 100%;
        max-width: 600px;
        border: 1px solid var(--navbar-border);
        animation: fadeIn 0.5s ease-out;
        backdrop-filter: blur(15px); /* Efecto Crystal Glass */
        -webkit-backdrop-filter: blur(15px);
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .badge {
        background-color: #e6f4f1;
        color: #1e3a34;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-block;
        margin-bottom: 0.8rem;
    }

    :root.dark .badge {
        background-color: rgba(162, 217, 206, 0.1);
        color: #A2D9CE;
    }

    .form-header h1 {
        font-size: 2.2rem;
        color: var(--heading-color);
        margin: 0 0 0.5rem 0;
    }

    .booking-subtitle-wrapper {
        margin: 0;
        min-height: 32px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Subtítulo con efecto de brillo (Text-Shadow) y transición lenta */
    #booking-subtitle {
        display: inline-block;
        font-size: 1.15rem; /* ~20% más grande */
        font-style: italic; /* Letra Cursiva */
        color: #D86A97; /* Rosa en tema claro */
        text-shadow: 0 0 12px rgba(216, 106, 151, 0.35); /* Brillo rosa sutil */
        transition: opacity 0.8s ease-in-out, text-shadow 0.8s ease-in-out;
        opacity: 1;
        will-change: opacity, text-shadow;
        text-align: center;
        transform: translateZ(0); /* Aceleración GPU */
    }

    :root.dark #booking-subtitle {
        color: #FFA8C5; /* Rosa pastel en tema oscuro */
        text-shadow: 0 0 18px rgba(255, 168, 197, 0.45); /* Brillo rosa luminoso */
    }

    /* Estado desvanecido (Fade Out) */
    #booking-subtitle.fade-out {
        opacity: 0;
        text-shadow: 0 0 20px rgba(216, 106, 151, 0);
    }

    .status-alert {
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        display: none;
        text-align: center;
    }

    .status-alert.error {
        background-color: #fce8e6;
        color: #a80700;
        border: 1px solid #fbc4c0;
    }

    .status-alert.success {
        background-color: #e6f4f1;
        color: #1e3a34;
        border: 1px solid #cce8e2;
    }

    :root.dark .status-alert.success {
        background-color: rgba(162, 217, 206, 0.1);
        color: #A2D9CE;
        border-color: rgba(162, 217, 206, 0.2);
    }

    .booking-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .input-row {
        display: flex;
        gap: 15px;
        width: 100%;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 1;
    }

    .input-group label {
        font-weight: 700;
        color: var(--heading-color);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group input,
    .select-wrapper select,
    .input-group textarea {
        width: 100%;
        padding: 0.9rem 1.2rem;
        border: 2px solid var(--navbar-border);
        border-radius: 14px;
        font-size: 0.95rem;
        box-sizing: border-box;
        transition: all 0.3s;
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: inherit;
    }

    .select-wrapper {
        position: relative;
        width: 100%;
    }

    .select-wrapper select {
        appearance: none;
    }

    .select-wrapper::after {
        content: '▼';
        font-size: 0.7rem;
        color: #A2D9CE;
        position: absolute;
        right: 1.2rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .input-group input:focus,
    .select-wrapper select:focus,
    .input-group textarea:focus {
        border-color: #A2D9CE;
        background-color: var(--card-bg);
        box-shadow: 0 0 0 4px rgba(162, 217, 206, 0.2);
        outline: none;
    }

    .helper-text {
        font-size: 0.8rem;
        color: var(--body-text-color);
        margin: 2px 0 0 0;
    }

    .confidential-label {
        color: #1e3a34;
        font-weight: 600;
    }

    :root.dark .confidential-label {
        color: #A2D9CE;
    }

    .submit-button {
        width: 100%;
        padding: 1.1rem;
        background-color: #2C3E50;
        color: white;
        border: none;
        border-radius: 14px;
        font-size: 1.1rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2;
    }

    .submit-button:hover {
        background-color: #34495e;
        transform: translateY(-2px);
    }

    .submit-button.loading .btn-text {
        visibility: hidden;
        opacity: 0;
    }

    .submit-button.loading .btn-spinner {
        display: block;
    }

    .btn-spinner {
        display: none;
        position: absolute;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 0.8s infinite linear;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .hidden {
        display: none !important;
    }

    @media (max-width: 768px) {
        .booking-container {
            padding: 2rem 1.5rem;
        }
        .input-row {
            flex-direction: column;
            gap: 1.5rem;
        }
    }
</style>
