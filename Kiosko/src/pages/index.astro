---
// Kiosko/src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Welcome from '../components/Welcome.astro';
import MentalHealthInfo from '../components/MentalHealthInfo.astro';
import Violentometro from '../components/Violentometro.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import NursingSection from '../components/NursingSection.astro';
import PsychologySection from '../components/PsychologySection.astro';
import ProjectStory from '../components/ProjectStory.astro';
import MuralBoard from '../components/MuralBoard.astro';
---

<Layout title="UT Care - Kiosko de Autoservicio">
	<!-- Canvas de Partículas Globales (Fondo Antigravedad) -->
	<canvas id="global-antigravity-canvas" class="global-background-canvas"></canvas>

	<header class="navbar">
		<div class="navbar-content">
			<!-- Columna Izquierda: Logo -->
			<div class="navbar-left">
				<div class="logo">Psicopedagogía</div>
			</div>
			
			<nav class="navbar-center">
				<a href="#welcome"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span> Inicio</a>
				<a href="#mural"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></span> Mural</a>
				<a href="#nuestra-historia"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg></span> Nuestra Historia</a>
				<a href="#salud-emocional"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></span> Salud Emocional</a>
				<a href="#bienestar-cuidado"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 22l10-10"/></svg></span> Bienestar y Cuidado</a>
				<a href="#violentometro"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></span> Violentómetro</a>
			</nav>
			
			<!-- Columna Derecha: Acciones -->
			<div class="navbar-right">
				<a href="/agendar" class="login-btn" id="nav-agenda-btn"><span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span> Agendar cita</a>
				<ThemeToggle />
				<button id="hamburger-menu-btn" class="hamburger-btn" aria-label="Abrir menú de navegación">
					<span class="hamburger-line"></span>
					<span class="hamburger-line"></span>
					<span class="hamburger-line"></span>
				</button>
			</div>
		</div>
	</header>

	<!-- Barra NavTab para Tablets y Smartphones -->
	<div class="mobile-nav-tabs">
		<button class="tab-btn active" data-tab="main">
			<span class="tab-icon">🏠</span>
			<span class="tab-label">Inicio</span>
		</button>
		<button class="tab-btn" data-tab="left-aside">
			<span class="tab-icon">🧠</span>
			<span class="tab-label">Psicología</span>
		</button>
		<button class="tab-btn" data-tab="right-aside">
			<span class="tab-icon">🩺</span>
			<span class="tab-label">Enfermería</span>
		</button>
	</div>

	<!-- Grid de Maquetación Global (Estilo Red Social) -->
	<div class="app-layout-grid">
		<!-- Panel Izquierdo: Check-in Emocional y Apoyo Psicopedagógico -->
		<aside class="app-aside left-aside">
			<!-- Tarjeta Check-in Emocional -->
			<div class="checkin-card glass-panel reveal">
				<h3>¿Cómo te sientes hoy?</h3>
				<p class="checkin-subtitle">Tómate un segundo para registrar tu estado de ánimo actual.</p>
				<div class="mood-selector">
					<button class="mood-btn" data-mood="happy" title="Feliz">
						<span class="mood-emoji">😊</span>
						<span class="mood-label">Bien</span>
					</button>
					<button class="mood-btn" data-mood="sad" title="Triste">
						<span class="mood-emoji">😢</span>
						<span class="mood-label">Triste</span>
					</button>
					<button class="mood-btn" data-mood="anxious" title="Ansioso">
						<span class="mood-emoji">😰</span>
						<span class="mood-label">Ansioso</span>
					</button>
					<button class="mood-btn" data-mood="angry" title="Enojado">
						<span class="mood-emoji">😡</span>
						<span class="mood-label">Molesto</span>
					</button>
					<button class="mood-btn" data-mood="tired" title="Cansado">
						<span class="mood-emoji">😴</span>
						<span class="mood-label">Cansado</span>
					</button>
				</div>
				<div id="mood-feedback" class="mood-feedback-container"></div>
			</div>
			<PsychologySection />
		</aside>

		<!-- Columna Central: Scroll Principal de Contenido -->
		<main>
			<Welcome />
			<MuralBoard />
			<ProjectStory />
			<MentalHealthInfo />
			<Violentometro />
		</main>

		<!-- Panel Derecho: Servicios de Enfermería y Enlaces Rápidos -->
		<aside class="app-aside right-aside">
			<NursingSection />
			
			<!-- Tarjeta Enlaces de Ayuda y Emergencias -->
			<div class="links-card glass-panel reveal">
				<h3>Enlaces de Ayuda</h3>
				
				<div class="links-section">
					<span class="section-label">AYUDA EN CRISIS 24/7</span>
					<a href="tel:8009112000" class="help-link-btn crisis">
						<span class="link-icon">📞</span>
						<div class="link-info">
							<span class="link-title">Línea de la Vida</span>
							<span class="link-desc">800 911 2000</span>
						</div>
					</a>
					<a href="tel:911" class="help-link-btn emergency">
						<span class="link-icon">🚨</span>
						<div class="link-info">
							<span class="link-title">Emergencias Campus</span>
							<span class="link-desc">Área Médica</span>
						</div>
					</a>
				</div>

				<div class="links-section mt-15">
					<span class="section-label">ATAJOS RÁPIDOS</span>
					<button class="help-link-btn quick" id="aside-agenda-btn">
						<span class="link-icon">📅</span>
						<div class="link-info">
							<span class="link-title">Agendar Cita</span>
							<span class="link-desc">Servicio Médico/Psicológico</span>
						</div>
					</button>
					<a href="#salud-emocional" class="help-link-btn quick">
						<span class="link-icon">✨</span>
						<div class="link-info">
							<span class="link-title">Consejos de Salud</span>
							<span class="link-desc">Tips de bienestar diario</span>
						</div>
					</a>
				</div>
			</div>
		</aside>
	</div>

	<!-- Modales de Enfermería y Psicología Desacoplados (Centrados Globales) -->
	<div id="nursing-modal-fixed" class="custom-modal-overlay">
		<div class="custom-modal-content">
			<button class="custom-close-btn" id="close-nursing-modal">&times;</button>
			<div class="modal-inner-header">
				<div class="modal-big-icon pop-in-soft" id="nursing-modal-icon"></div>
				<h2 id="nursing-modal-title"></h2>
			</div>
			<div class="modal-inner-body">
				<p id="nursing-modal-desc"></p>
				<div class="modal-inner-highlights">
					<h4>Puntos Clave</h4>
					<ul id="nursing-modal-list"></ul>
				</div>
			</div>
			<button class="modal-inner-close-action" id="btn-nursing-close">Cerrar</button>
		</div>
	</div>

	<div id="psych-modal-fixed" class="custom-modal-overlay">
		<div class="custom-modal-content">
			<button class="custom-close-btn" id="close-psych-modal">&times;</button>
			<div class="modal-inner-header">
				<div class="modal-big-icon pop-in-soft" id="psych-modal-icon"></div>
				<h2 id="psych-modal-title"></h2>
			</div>
			<div class="modal-inner-body">
				<p id="psych-modal-desc"></p>
				<div class="modal-inner-highlights">
					<h4>Información Clave</h4>
					<ul id="psych-modal-list"></ul>
				</div>
			</div>
			<button class="modal-inner-close-action" id="btn-psych-close">Entendido</button>
		</div>
	</div>

	<!-- Modal para ver el post completo del Mural (Desacoplado) -->
	<div id="mural-modal" class="mural-modal">
		<div class="mural-modal-overlay" id="mural-modal-overlay"></div>
		<div class="mural-modal-content">
			<button class="modal-close" id="mural-modal-close" aria-label="Cerrar modal">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
			<div class="modal-body" id="modal-body">
				<!-- Se inyectará el artículo detallado aquí -->
			</div>
		</div>
	</div>

	<!-- Alerta sutil flotante para notificaciones del Mural -->
	<div id="mural-toast" class="mural-toast">
		<span id="mural-toast-text"></span>
	</div>

	<!-- Botón Burbuja Flotante de Agendar Cita (FAB) para móviles y tablets (Estructura Colapsable) -->
	<div id="floating-agenda-fab" class="floating-agenda-fab collapsed animate-pulse">
		<button id="fab-toggle-arrow" class="fab-toggle-arrow" aria-label="Expandir agenda">
			<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="15 18 9 12 15 6"></polyline>
			</svg>
		</button>
		<button id="fab-action-trigger" class="fab-action-trigger" aria-label="Agendar cita prioritaria">
			<span class="fab-icon">📅</span>
			<span class="fab-label">Agendar cita</span>
		</button>
	</div>

	<!-- Menú Lateral Deslizable (Drawer) para móviles y tablets -->
	<div id="drawer-overlay" class="drawer-overlay"></div>
	<div id="mobile-drawer" class="mobile-drawer">
		<div class="drawer-header">
			<div class="drawer-logo">Psicopedagogía</div>
			<button id="drawer-close-btn" class="drawer-close-btn" aria-label="Cerrar menú">&times;</button>
		</div>
		<nav class="drawer-nav">
			<a href="#welcome" class="drawer-link"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span> Inicio</a>
			<a href="#mural" class="drawer-link"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></span> Mural</a>
			<a href="#nuestra-historia" class="drawer-link"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg></span> Nuestra Historia</a>
			<a href="#salud-emocional" class="drawer-link"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></span> Salud Emocional</a>
			<a href="#bienestar-cuidado" class="drawer-link"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 22l10-10"/></svg></span> Bienestar y Cuidado</a>
			<a href="#violentometro" class="drawer-link"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></span> Violentómetro</a>
		</nav>
	</div>
</Layout>

<script>
	// Configurar Check-in Emocional
	const setupCheckIn = () => {
		const moodButtons = document.querySelectorAll('.mood-btn');
		const feedbackContainer = document.getElementById('mood-feedback');
		
		if (!feedbackContainer) return;
		
		const feedbackMessages = {
			happy: {
				emoji: '✨',
				text: '¡Qué gran noticia! Mantén esa energía positiva y contagia tu día a los demás.',
				actionText: 'Ver consejos de salud',
				actionUrl: '#salud-emocional'
			},
			sad: {
				emoji: '🌿',
				text: 'Sentirse triste es parte de ser humano. Si necesitas desahogarte, estamos aquí para escucharte.',
				actionText: 'Hablar con alguien',
				actionUrl: '/agendar'
			},
			anxious: {
				emoji: '🧘',
				text: 'Respira hondo... Todo estará bien. Prueba realizar técnicas de relajación en la sección de Salud Emocional.',
				actionText: 'Ver técnicas de relajación',
				actionUrl: '#salud-emocional'
			},
			angry: {
				emoji: '💡',
				text: 'Es normal sentir enojo. Tómate un momento para respirar y calmar tu mente antes de actuar.',
				actionText: 'Ver tips de control',
				actionUrl: '#salud-emocional'
			},
			tired: {
				emoji: '💤',
				text: 'El descanso es vital para tu salud física y mental. Tómate un tiempo para recargar energías hoy.',
				actionText: 'Tips de higiene del sueño',
				actionUrl: '#bienestar-cuidado'
			}
		};

		moodButtons.forEach(btn => {
			// Clonar y reemplazar para evitar listeners duplicados al recargar componentes
			const newBtn = btn.cloneNode(true);
			btn.parentNode.replaceChild(newBtn, btn);

			newBtn.addEventListener('click', () => {
				// Remover active de todos los botones
				const allBtns = document.querySelectorAll('.mood-btn');
				allBtns.forEach(b => b.classList.remove('active'));
				
				// Agregar active al pulsado
				newBtn.classList.add('active');
				
				const mood = newBtn.getAttribute('data-mood');
				const config = feedbackMessages[mood];
				
				if (config) {
					feedbackContainer.innerHTML = `
						<div class="feedback-card fade-in">
							<span class="feedback-emoji">${config.emoji}</span>
							<p class="feedback-text">${config.text}</p>
							<a href="${config.actionUrl}" class="feedback-action-btn">${config.actionText} →</a>
						</div>
					`;
				}
			});
		});
	};


	// --- PARTÍCULAS ANTIGRAVEDAD GLOBALES (CANVAS FIJO) ---
	const initGlobalParticles = () => {
		const canvas = document.getElementById('global-antigravity-canvas');
		if (!canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let width = window.innerWidth;
		let height = window.innerHeight;
		canvas.width = width;
		canvas.height = height;

		let particles = [];
		const maxParticles = 60; // Número de partículas ideal para no sobrecargar el renderizado

		const createParticle = (isInitial = false) => {
			return {
				x: Math.random() * width,
				y: isInitial ? Math.random() * height : height + Math.random() * 50,
				radius: Math.random() * 5 + 1.5, // Tamaños variados (1.5px a 6.5px)
				speedY: -(Math.random() * 0.35 + 0.15), // Movimiento ascendente sutil
				speedX: Math.random() * 0.15 - 0.075, // Desviación lateral mínima
				alpha: Math.random() * 0.25 + 0.08, // Opacidad baja y sumamente elegante
				wobble: Math.random() * Math.PI * 2,
				wobbleSpeed: Math.random() * 0.008 + 0.003
			};
		};

		// Generar partículas iniciales
		for (let i = 0; i < maxParticles; i++) {
			particles.push(createParticle(true));
		}

		let animationFrameId;

		const animate = () => {
			ctx.clearRect(0, 0, width, height);

			const isDark = document.documentElement.classList.contains('dark');
			const particleColor = isDark ? '162, 217, 206' : '44, 62, 80'; // verde-azul / gris oscuro

			particles.forEach((p, index) => {
				p.y += p.speedY;
				p.wobble += p.wobbleSpeed;
				p.x += p.speedX + Math.sin(p.wobble) * 0.12;

				// Si la partícula sale por arriba, regenerarla abajo
				if (p.y + p.radius < 0) {
					particles[index] = createParticle(false);
					return;
				}

				ctx.beginPath();
				ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
				ctx.fillStyle = `rgba(${particleColor}, ${p.alpha})`;
				ctx.fill();
			});

			animationFrameId = requestAnimationFrame(animate);
		};

		animate();

		const handleResize = () => {
			if (!canvas) return;
			width = window.innerWidth;
			height = window.innerHeight;
			canvas.width = width;
			canvas.height = height;
		};

		window.addEventListener('resize', handleResize);

		return () => {
			window.removeEventListener('resize', handleResize);
			cancelAnimationFrame(animationFrameId);
		};
	};

	let particlesCleanup;
	const startParticles = () => {
		if (particlesCleanup) particlesCleanup();
		particlesCleanup = initGlobalParticles();
	};

	// Configurar Pestañas para Móvil y Tablet
	const setupMobileTabs = () => {
		const tabButtons = document.querySelectorAll('.mobile-nav-tabs .tab-btn');
		const mainContent = document.querySelector('.app-layout-grid main');
		const leftAside = document.querySelector('.app-aside.left-aside');
		const rightAside = document.querySelector('.app-aside.right-aside');
		
		if (!tabButtons.length || !mainContent || !leftAside || !rightAside) return;
		
		const tabContents = {
			'main': mainContent,
			'left-aside': leftAside,
			'right-aside': rightAside
		};

		const updateTabState = () => {
			if (window.innerWidth <= 1100) {
				const activeBtn = document.querySelector('.mobile-nav-tabs .tab-btn.active');
				const activeTabKey = activeBtn ? activeBtn.getAttribute('data-tab') : 'main';
				
				Object.keys(tabContents).forEach(key => {
					if (key === activeTabKey) {
						tabContents[key].classList.add('active-tab');
					} else {
						tabContents[key].classList.remove('active-tab');
					}
				});
			} else {
				Object.values(tabContents).forEach(content => {
					content.classList.remove('active-tab');
				});
			}
		};

		tabButtons.forEach(btn => {
			// Clonar y reemplazar para evitar listeners duplicados
			const newBtn = btn.cloneNode(true);
			btn.parentNode.replaceChild(newBtn, btn);
			
			newBtn.addEventListener('click', () => {
				const allBtns = document.querySelectorAll('.mobile-nav-tabs .tab-btn');
				allBtns.forEach(b => b.classList.remove('active'));
				newBtn.classList.add('active');
				updateTabState();
				
				// Scroll suave al inicio al cambiar de pestaña
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});
		});

		window.removeEventListener('resize', updateTabState);
		window.addEventListener('resize', updateTabState);
		updateTabState();
	};

	// Configurar Menú Lateral (Drawer) para móviles/tabletas
	const setupMobileDrawer = () => {
		// Limpiar cualquier bloqueo residual de scroll del body al cargar
		document.body.style.overflow = '';

		const hamburger = document.getElementById('hamburger-menu-btn');
		const drawer = document.getElementById('mobile-drawer');
		const overlay = document.getElementById('drawer-overlay');
		const closeBtn = document.getElementById('drawer-close-btn');
		const drawerLinks = document.querySelectorAll('.drawer-link');

		if (!hamburger || !drawer || !overlay || !closeBtn) return;

		const openDrawer = () => {
			drawer.classList.add('active');
			overlay.classList.add('active');
			document.body.style.overflow = 'hidden';
		};

		const closeDrawer = () => {
			drawer.classList.remove('active');
			overlay.classList.remove('active');
			document.body.style.overflow = '';
		};

		// Clonar y reemplazar para evitar listeners duplicados
		const newHamburger = hamburger.cloneNode(true);
		hamburger.parentNode.replaceChild(newHamburger, hamburger);
		newHamburger.addEventListener('click', openDrawer);

		const newOverlay = overlay.cloneNode(true);
		overlay.parentNode.replaceChild(newOverlay, overlay);
		newOverlay.addEventListener('click', closeDrawer);

		const newCloseBtn = closeBtn.cloneNode(true);
		closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);
		newCloseBtn.addEventListener('click', closeDrawer);

		drawerLinks.forEach(link => {
			link.removeEventListener('click', closeDrawer);
			link.addEventListener('click', closeDrawer);
		});
	};

	// Configurar Botón Flotante (FAB) de agendar cita
	const setupFloatingFAB = () => {
		const fab = document.getElementById('floating-agenda-fab');
		const toggleArrow = document.getElementById('fab-toggle-arrow');
		const actionTrigger = document.getElementById('fab-action-trigger');

		if (!fab || !toggleArrow || !actionTrigger) return;

		// Clonar y reemplazar para evitar listeners duplicados
		const newToggle = toggleArrow.cloneNode(true);
		toggleArrow.parentNode.replaceChild(newToggle, toggleArrow);
		
		newToggle.addEventListener('click', (e) => {
			e.stopPropagation();
			fab.classList.toggle('collapsed');
			
			const isCollapsed = fab.classList.contains('collapsed');
			newToggle.setAttribute('aria-label', isCollapsed ? 'Expandir agenda' : 'Colapsar agenda');
		});

		const newTrigger = actionTrigger.cloneNode(true);
		actionTrigger.parentNode.replaceChild(newTrigger, actionTrigger);
		
		newTrigger.addEventListener('click', (e) => {
			window.location.href = '/agendar';
		});
	};

	// Inicializar
	document.addEventListener('DOMContentLoaded', () => {
		setupCheckIn();
		startParticles();
		setupMobileTabs();
		setupMobileDrawer();
		setupFloatingFAB();
	});
	document.addEventListener('astro:after-swap', () => {
		setupCheckIn();
		startParticles();
		setupMobileTabs();
		setupMobileDrawer();
		setupFloatingFAB();
	});
</script>

