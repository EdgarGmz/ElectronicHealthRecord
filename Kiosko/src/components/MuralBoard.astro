---
// Kiosko/src/components/MuralBoard.astro
---
<section id="mural" class="mural-section">
    <div class="container">
        <div class="mural-header text-center">
            <span class="badge">Mural UT Care</span>
            <h2>Consejos, Eventos e Historias de Salud</h2>
            <p class="subtitle">Creado por nuestro equipo de psicólogos y enfermeros para ti.</p>
            <div class="divider"></div>
        </div>

        <!-- Filtros de categoría -->
        <div class="filter-container">
            <button class="filter-btn active" data-category="all">Todos</button>
            <button class="filter-btn" data-category="Salud Mental">Salud Mental</button>
            <button class="filter-btn" data-category="Salud Física">Salud Física</button>
            <button class="filter-btn" data-category="Evento">Eventos</button>
            <button class="filter-btn" data-category="Día Especial">Días Especiales</button>
        </div>

        <!-- Estructura de Carrusel de publicaciones -->
        <div class="mural-carousel-wrapper">
            <button class="carousel-control prev" id="carousel-prev" aria-label="Anterior">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            
            <div class="mural-carousel-container" id="carousel-container">
                <div id="mural-grid" class="mural-carousel-track">
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Cargando publicaciones...</p>
                    </div>
                </div>
            </div>
            
            <button class="carousel-control next" id="carousel-next" aria-label="Siguiente">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>

        <!-- Indicadores (dots) -->
        <div class="carousel-indicators" id="carousel-indicators"></div>
    </div>
</section>

<!-- Modal para ver el post completo -->
<div id="mural-modal" class="mural-modal">
    <div class="mural-modal-overlay" id="modal-overlay"></div>
    <div class="mural-modal-content">
        <button class="modal-close" id="modal-close" aria-label="Cerrar modal">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <div class="modal-body" id="modal-body">
            <!-- Se inyectará el artículo detallado aquí -->
        </div>
    </div>
</div>

<!-- Alerta sutil flotante para notificaciones -->
<div id="mural-toast" class="mural-toast">
    <span id="mural-toast-text"></span>
</div>

<script>
    import { API_BASE_URL } from '../utils/api';

    let blogPosts = [];

    const categoryColors = {
        'Salud Mental': 'mint-card',
        'Salud Física': 'peach-card',
        'Evento': 'lavender-card',
        'Día Especial': 'blue-card'
    };

    const getCardClass = (category) => {
        return categoryColors[category] || 'mint-card';
    };

    const formatDate = (dateString) => {
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        return new Date(dateString).toLocaleDateString('es-ES', options);
    };

    // Ocultar o mostrar controles de carrusel
    const toggleCarouselControls = (show) => {
        const prevBtn = document.getElementById('carousel-prev');
        const nextBtn = document.getElementById('carousel-next');
        const indicators = document.getElementById('carousel-indicators');
        const displayVal = show ? '' : 'none';
        
        if (prevBtn) prevBtn.style.display = displayVal;
        if (nextBtn) nextBtn.style.display = displayVal;
        if (indicators) indicators.style.display = displayVal;
    };

    // Renderizar posts en el DOM
    const renderPosts = (filter = 'all') => {
        const grid = document.getElementById('mural-grid');
        if (!grid) return;

        const filtered = filter === 'all' 
            ? blogPosts 
            : blogPosts.filter(post => post.category === filter);

        if (filtered.length === 0) {
            grid.innerHTML = `
                <div class="empty-state">
                    <p>No hay publicaciones disponibles en esta categoría por el momento.</p>
                </div>
            `;
            toggleCarouselControls(false);
            return;
        }

        toggleCarouselControls(true);

        // Obtener likes del localStorage
        const likedPosts = JSON.parse(localStorage.getItem('likedPosts') || '[]');

        grid.innerHTML = filtered.map(post => {
            const isLiked = likedPosts.includes(post.id);
            const cardClass = getCardClass(post.category);
            const authorName = post.author 
                ? `Psic. ${post.author.firstName} ${post.author.lastName}`
                : 'Departamento de Psicología';
            
            // Recortar texto para la tarjeta de blog
            const truncatedContent = post.content.length > 130 
                ? post.content.substring(0, 130) + '...' 
                : post.content;

            return `
                <article id="post-${post.id}" class="mural-card ${cardClass} reveal-card" data-post-id="${post.id}">
                    ${post.imageUrl ? `
                        <div class="card-image-wrapper">
                            <img src="${post.imageUrl}" alt="${post.title}" class="card-image" loading="lazy" onerror="this.parentNode.style.display='none'" />
                        </div>
                    ` : ''}
                    <div class="card-content">
                        <div class="card-meta">
                            <span class="card-category">${post.category}</span>
                            <span class="card-date">${formatDate(post.createdAt)}</span>
                        </div>
                        <h3 class="card-title">${post.title}</h3>
                        <p class="card-body-text">${truncatedContent}</p>
                        
                        <button class="read-story-btn" data-id="${post.id}">
                            Leer historia &rarr;
                        </button>
                        
                        <div class="card-footer">
                            <span class="card-author">${authorName}</span>
                            <div class="card-actions">
                                <button class="like-btn ${isLiked ? 'liked' : ''}" data-id="${post.id}" title="${isLiked ? 'Ya te gusta' : 'Dar me gusta'}">
                                    <svg class="heart-icon" viewBox="0 0 24 24">
                                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                    </svg>
                                    <span class="likes-count">${post.likes}</span>
                                </button>
                                <button class="share-btn" data-id="${post.id}" data-title="${post.title}" title="Compartir publicación">
                                    <svg class="share-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="18" cy="5" r="3"></circle>
                                        <circle cx="6" cy="12" r="3"></circle>
                                        <circle cx="18" cy="19" r="3"></circle>
                                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </article>
            `;
        }).join('');

        setupCardInteractions();
        setupCarousel();
    };

    // Alertas Toast sutiles
    const showToast = (message) => {
        const toast = document.getElementById('mural-toast');
        const text = document.getElementById('mural-toast-text');
        if (toast && text) {
            text.textContent = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }
    };

    // Abrir Modal
    const openModal = (post) => {
        const modal = document.getElementById('mural-modal');
        const modalBody = document.getElementById('modal-body');
        if (!modal || !modalBody) return;

        const likedPosts = JSON.parse(localStorage.getItem('likedPosts') || '[]');
        const isLiked = likedPosts.includes(post.id);
        const authorName = post.author 
            ? `Psic. ${post.author.firstName} ${post.author.lastName}`
            : 'Departamento de Psicología';

        modalBody.innerHTML = `
            <article class="modal-article">
                ${post.imageUrl ? `
                    <div class="modal-image-wrapper">
                        <img src="${post.imageUrl}" alt="${post.title}" class="modal-image" onerror="this.parentNode.style.display='none'" />
                    </div>
                ` : ''}
                <div class="modal-article-content">
                    <div class="modal-article-meta">
                        <span class="modal-category badge">${post.category}</span>
                        <span class="modal-date">${formatDate(post.createdAt)}</span>
                    </div>
                    
                    <h2 class="modal-article-title">${post.title}</h2>
                    
                    <div class="modal-author-section">
                        <div class="author-avatar">🧠</div>
                        <div class="author-info">
                            <span class="author-label">Escrito por:</span>
                            <span class="author-name">${authorName}</span>
                        </div>
                    </div>
                    
                    <div class="modal-article-body">
                        ${post.content.split('\n').map(p => p.trim() ? `<p>${p.trim()}</p>` : '').join('')}
                    </div>
                    
                    <div class="modal-article-footer">
                        <div class="modal-actions">
                            <button class="like-btn modal-like-btn ${isLiked ? 'liked' : ''}" data-id="${post.id}" title="${isLiked ? 'Ya te gusta' : 'Dar me gusta'}">
                                <svg class="heart-icon" viewBox="0 0 24 24">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                </svg>
                                <span class="likes-count">${post.likes}</span>
                            </button>
                            <button class="share-btn modal-share-btn" data-id="${post.id}" data-title="${post.title}" title="Compartir publicación">
                                <svg class="share-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="18" cy="5" r="3"></circle>
                                    <circle cx="6" cy="12" r="3"></circle>
                                    <circle cx="18" cy="19" r="3"></circle>
                                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                </svg>
                                Compartir
                            </button>
                        </div>
                    </div>
                </div>
            </article>
        `;

        modal.classList.add('open');
        document.body.style.overflow = 'hidden';

        setupModalInteractions(post.id);
    };

    const closeModal = () => {
        const modal = document.getElementById('mural-modal');
        if (modal) {
            modal.classList.remove('open');
            document.body.style.overflow = '';
        }
    };

    const setupModalClose = () => {
        const closeBtn = document.getElementById('modal-close');
        const overlay = document.getElementById('modal-overlay');
        
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (overlay) overlay.addEventListener('click', closeModal);
        
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
    };

    // Sincronizar me gustas y compartir en el modal
    const setupModalInteractions = (postId) => {
        const modalLikeBtn = document.querySelector('.modal-like-btn');
        const modalShareBtn = document.querySelector('.modal-share-btn');
        
        if (modalLikeBtn) {
            modalLikeBtn.addEventListener('click', async (e) => {
                const btn = e.currentTarget;
                let likedPosts = JSON.parse(localStorage.getItem('likedPosts') || '[]');
                
                if (likedPosts.includes(postId)) {
                    showToast('Ya has reaccionado a esta publicación 😊');
                    return;
                }
                
                btn.classList.add('liked', 'animating');
                setTimeout(() => btn.classList.remove('animating'), 600);

                try {
                    const response = await fetch(`${API_BASE_URL}/blogs/${postId}/like`, {
                        method: 'POST'
                    });
                    
                    if (response.ok) {
                        const updatedPost = await response.json();
                        const likesCountSpan = btn.querySelector('.likes-count');
                        if (likesCountSpan) {
                            likesCountSpan.textContent = updatedPost.likes;
                        }
                        
                        likedPosts.push(postId);
                        localStorage.setItem('likedPosts', JSON.stringify(likedPosts));
                        
                        const postIndex = blogPosts.findIndex(p => p.id === postId);
                        if (postIndex !== -1) {
                            blogPosts[postIndex].likes = updatedPost.likes;
                        }
                        
                        // Sincronizar la tarjeta del carrusel
                        const cardLikeBtn = document.querySelector(`.mural-card[data-post-id="${postId}"] .like-btn`);
                        if (cardLikeBtn) {
                            cardLikeBtn.classList.add('liked');
                            const cardLikesCount = cardLikeBtn.querySelector('.likes-count');
                            if (cardLikesCount) {
                                cardLikesCount.textContent = updatedPost.likes;
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error al dar like en modal:', error);
                    showToast('Error de conexión al guardar tu reacción.');
                }
            });
        }
        
        if (modalShareBtn) {
            modalShareBtn.addEventListener('click', async () => {
                const post = blogPosts.find(p => p.id === postId);
                if (!post) return;
                const shareUrl = `${window.location.origin}${window.location.pathname}#post-${postId}`;
                
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: post.title,
                            text: `Mira este consejo de salud de UT Care: ${post.title}`,
                            url: shareUrl
                        });
                    } catch (err) {}
                } else {
                    try {
                        await navigator.clipboard.writeText(shareUrl);
                        showToast('Enlace copiado al portapapeles 📋');
                    } catch (err) {
                        showToast('No se pudo copiar el enlace.');
                    }
                }
            });
        }
    };

    // Configurar interacciones de Likes y Compartir en Tarjetas
    const setupCardInteractions = () => {
        // Clic en tarjeta para abrir modal
        document.querySelectorAll('.mural-card').forEach(card => {
            const postId = card.getAttribute('data-post-id');
            const post = blogPosts.find(p => p.id === postId);
            
            card.addEventListener('click', (e) => {
                const target = e.target;
                // Si el clic es en botones de acción, no abrir modal
                if (target.closest('.like-btn') || target.closest('.share-btn') || target.closest('.card-actions')) {
                    return;
                }
                if (post) {
                    openModal(post);
                }
            });
        });

        // Likes de tarjetas
        document.querySelectorAll('.mural-card .like-btn').forEach(button => {
            button.addEventListener('click', async (e) => {
                e.stopPropagation();
                const btn = e.currentTarget;
                const postId = btn.getAttribute('data-id');
                const likesCountSpan = btn.querySelector('.likes-count');
                
                let likedPosts = JSON.parse(localStorage.getItem('likedPosts') || '[]');
                
                if (likedPosts.includes(postId)) {
                    showToast('Ya has reaccionado a esta publicación 😊');
                    return;
                }

                btn.classList.add('liked', 'animating');
                setTimeout(() => btn.classList.remove('animating'), 600);

                try {
                    const response = await fetch(`${API_BASE_URL}/blogs/${postId}/like`, {
                        method: 'POST'
                    });
                    
                    if (response.ok) {
                        const updatedPost = await response.json();
                        if (likesCountSpan) {
                            likesCountSpan.textContent = updatedPost.likes;
                        }
                        
                        likedPosts.push(postId);
                        localStorage.setItem('likedPosts', JSON.stringify(likedPosts));
                        
                        const postIndex = blogPosts.findIndex(p => p.id === postId);
                        if (postIndex !== -1) {
                            blogPosts[postIndex].likes = updatedPost.likes;
                        }

                        // Sincronizar modal si está abierto y es de esta publicación
                        const openModalEl = document.getElementById('mural-modal');
                        if (openModalEl && openModalEl.classList.contains('open')) {
                            const modalLikeBtn = openModalEl.querySelector('.modal-like-btn');
                            if (modalLikeBtn && modalLikeBtn.getAttribute('data-id') === postId) {
                                modalLikeBtn.classList.add('liked');
                                const modalLikesCount = modalLikeBtn.querySelector('.likes-count');
                                if (modalLikesCount) {
                                    modalLikesCount.textContent = updatedPost.likes;
                                }
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error al dar like:', error);
                    showToast('Error de conexión.');
                }
            });
        });

        // Compartir en tarjetas
        document.querySelectorAll('.mural-card .share-btn').forEach(button => {
            button.addEventListener('click', async (e) => {
                e.stopPropagation();
                const btn = e.currentTarget;
                const postId = btn.getAttribute('data-id');
                const postTitle = btn.getAttribute('data-title');
                const shareUrl = `${window.location.origin}${window.location.pathname}#post-${postId}`;

                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: postTitle,
                            text: `Mira este consejo de salud de UT Care: ${postTitle}`,
                            url: shareUrl
                        });
                    } catch (err) {}
                } else {
                    try {
                        await navigator.clipboard.writeText(shareUrl);
                        showToast('Enlace copiado al portapapeles 📋');
                    } catch (err) {
                        showToast('No se pudo copiar el enlace.');
                    }
                }
            });
        });
    };

    // Configurar carrusel horizontal
    const setupCarousel = () => {
        const container = document.getElementById('carousel-container');
        const track = document.getElementById('mural-grid');
        const prevBtn = document.getElementById('carousel-prev');
        const nextBtn = document.getElementById('carousel-next');
        const indicatorsContainer = document.getElementById('carousel-indicators');
        
        if (!container || !track || !prevBtn || !nextBtn || !indicatorsContainer) return;
        
        const cards = track.querySelectorAll('.mural-card');
        if (cards.length === 0) return;
        
        // Generar dots
        indicatorsContainer.innerHTML = '';
        cards.forEach((card, index) => {
            const dot = document.createElement('button');
            dot.classList.add('indicator-dot');
            if (index === 0) dot.classList.add('active');
            dot.setAttribute('aria-label', `Ver publicación ${index + 1}`);
            dot.addEventListener('click', () => {
                const cardWidth = card.getBoundingClientRect().width;
                const gap = parseInt(window.getComputedStyle(track).gap) || 0;
                container.scrollTo({
                    left: index * (cardWidth + gap),
                    behavior: 'smooth'
                });
            });
            indicatorsContainer.appendChild(dot);
        });
        
        // Obtener tamaño del desplazamiento (ancho de tarjeta + espacio)
        const getScrollAmount = () => {
            const cardWidth = cards[0].getBoundingClientRect().width;
            const gap = parseInt(window.getComputedStyle(track).gap) || 0;
            return cardWidth + gap;
        };
        
        // Clonar botones para remover listeners previos
        const prevClone = prevBtn.cloneNode(true);
        const nextClone = nextBtn.cloneNode(true);
        prevBtn.replaceWith(prevClone);
        nextBtn.replaceWith(nextClone);
        
        prevClone.addEventListener('click', () => {
            container.scrollBy({
                left: -getScrollAmount(),
                behavior: 'smooth'
            });
        });
        
        nextClone.addEventListener('click', () => {
            container.scrollBy({
                left: getScrollAmount(),
                behavior: 'smooth'
            });
        });
        
        // Sincronizar dots al hacer scroll
        const updateDots = () => {
            const dots = indicatorsContainer.querySelectorAll('.indicator-dot');
            if (dots.length === 0) return;
            
            const scrollLeft = container.scrollLeft;
            const cardWidth = cards[0].getBoundingClientRect().width;
            const gap = parseInt(window.getComputedStyle(track).gap) || 0;
            const step = cardWidth + gap;
            
            const activeIndex = Math.round(scrollLeft / step);
            
            dots.forEach((dot, index) => {
                if (index === activeIndex) {
                    dot.classList.add('active');
                } else {
                    dot.classList.remove('active');
                }
            });
        };
        
        // Deshabilitar botones en extremos
        const checkArrows = () => {
            const scrollLeft = container.scrollLeft;
            const maxScroll = container.scrollWidth - container.clientWidth;
            
            if (scrollLeft <= 5) {
                prevClone.classList.add('disabled');
            } else {
                prevClone.classList.remove('disabled');
            }
            
            if (scrollLeft >= maxScroll - 5) {
                nextClone.classList.add('disabled');
            } else {
                nextClone.classList.remove('disabled');
            }
        };
        
        container.addEventListener('scroll', () => {
            updateDots();
            checkArrows();
        });
        
        // Inicializar flechas
        checkArrows();
    };

    // Manejar filtros
    const setupFilters = () => {
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                const filter = e.currentTarget.getAttribute('data-category');
                e.currentTarget.classList.add('active');
                renderPosts(filter);
                // Resetear posición del scroll al cambiar de filtro
                const container = document.getElementById('carousel-container');
                if (container) container.scrollLeft = 0;
            });
        });
    };

    // Lógica de Scroll y Resaltado Suave en Hash
    const handleHashHighlight = () => {
        const hash = window.location.hash;
        if (hash && hash.startsWith('#post-')) {
            const targetElement = document.querySelector(hash);
            if (targetElement) {
                setTimeout(() => {
                    targetElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    targetElement.classList.add('highlight-glow');
                    setTimeout(() => {
                        targetElement.classList.remove('highlight-glow');
                    }, 3000);
                }, 800);
            }
        }
    };

    // Cargar posts del API
    const loadBlogs = async () => {
        try {
            const response = await fetch(`${API_BASE_URL}/blogs`);
            if (response.ok) {
                blogPosts = await response.json();
                // Ordenar cronológicamente (más recientes primero)
                blogPosts.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
                renderPosts();
                handleHashHighlight();
            } else {
                throw new Error('Error cargando posts');
            }
        } catch (error) {
            console.error('Error fetching blogs:', error);
            const grid = document.getElementById('mural-grid');
            if (grid) {
                grid.innerHTML = `
                    <div class="empty-state">
                        <p>No pudimos cargar las publicaciones del mural. Por favor, intenta de nuevo más tarde.</p>
                    </div>
                `;
            }
            toggleCarouselControls(false);
        }
    };

    // Iniciar scripts en el cliente
    document.addEventListener('DOMContentLoaded', () => {
        loadBlogs();
        setupFilters();
        setupModalClose();
    });

    document.addEventListener('astro:after-swap', () => {
        loadBlogs();
        setupFilters();
        setupModalClose();
    });
</script>

<style is:global>
    .mural-section {
        padding: 5rem 2rem;
        background-color: var(--bg-color);
        width: 100%;
        box-sizing: border-box;
        position: relative;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        position: relative;
    }

    .mural-header {
        margin-bottom: 3rem;
    }

    .mural-header h2 {
        font-size: 2.8rem;
        margin: 0.5rem 0 1rem;
        color: var(--heading-color);
        font-family: 'Playfair Display', serif;
    }

    .subtitle {
        color: var(--body-text-color);
        font-size: 1.1rem;
        margin: 0;
    }

    .divider {
        width: 80px;
        height: 4px;
        background-color: #A2D9CE;
        margin: 1.5rem auto 0;
        border-radius: 2px;
    }

    .filter-container {
        display: flex;
        justify-content: center;
        gap: 0.8rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .filter-btn {
