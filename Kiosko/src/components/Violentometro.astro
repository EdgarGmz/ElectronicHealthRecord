---
// Kiosko/src/components/Violentometro.astro
const sections = [
    {
        title: "TEN CUIDADO",
        color: "#1e90ff", // Azul
        rgb: "30, 144, 255",
        items: [
            { text: "Hacer bromas hirientes", description: "Comentarios que buscan ofender o menospreciar, disfrazados de humor." },
            { text: "Chantajear", description: "Manipular a alguien con amenazas para conseguir algo, generando culpa o miedo." },
            { text: "Mentir / Engañar", description: "Alterar la verdad o dar información falsa para beneficiarse o dañar a otra persona." },
            { text: "Ignorar / Ley del hielo", description: "Excluir o no prestar atención deliberadamente a alguien para castigarle o controlar su comportamiento." },
            { text: "Celar", description: "Sentir envidia o desconfianza excesiva hacia la pareja o amigos, limitando su libertad." },
            { text: "Culpabilizar", description: "Atribuir a otra persona la responsabilidad de problemas o errores propios, generando en ella sentimientos de culpa." },
            { text: "Descalificar", description: "Minimizar o anular las opiniones, sentimientos o capacidades de alguien, haciéndole sentir inferior." },
            { text: "Ridiculizar / Ofender", description: "Burlarse, hacer mofa o insultar a alguien, afectando su autoestima y dignidad." },
            { text: "Humillar en público", description: "Exponer a alguien a la vergüenza o al ridículo frente a otras personas." },
            { text: "Intimidar / Amenazar", description: "Asustar o presionar a alguien para que haga algo que no quiere, usando el miedo como herramienta." },
            { text: "Controlar / Prohibir", description: "Restringir la autonomía de alguien imponiendo reglas sobre su forma de vestir, con quién se relaciona o cómo gasta su dinero." }
        ]
    },
    {
        title: "REACCIONA",
        color: "#dc3545", // Rojo
        rgb: "220, 53, 69",
        items: [
            { text: "Golpear 'jugando'", description: "Contacto físico agresivo disfrazado de juego que causa dolor o incomodidad." },
            { text: "Pellizcar / Arañar", description: "Agresión física leve que deja marcas o causa dolor punzante." },
            { text: "Empujar / Jalonear", description: "Uso de la fuerza física para mover o desestabilizar a alguien sin su consentimiento." },
            { text: "Cachetear", description: "Golpear el rostro con la mano abierta, una agresión física directa y humillante." },
            { text: "Patear", description: "Golpear con el pie, a menudo buscando causar daño físico o intimidación." },
            { text: "Manosear", description: "Tocar a alguien de forma sexual sin su permiso, invadiendo su espacio personal." },
            { text: "Acariciar agresivamente", description: "Contacto físico que parece afectuoso pero es forzado, incómodo o excesivo." },
            { text: "Encerrar / Aislar", description: "Impedir la libertad de movimiento de alguien o alejarle de sus seres queridos." },
            { text: "Amenazar con objetos", description: "Usar objetos o armas para intimidar y generar miedo." },
        ]
    },
    {
        title: "ACTÚA",
        color: "#6f42c1", // Púrpura
        rgb: "111, 66, 193",
        items: [
            { text: "Amenazar de muerte", description: "Expresar la intención de causar la muerte a alguien, generando terror extremo." },
            { text: "Forzar a una relación sexual", description: "Presionar o coaccionar a alguien para tener relaciones sexuales contra su voluntad." },
            { text: "Abusar sexualmente", description: "Cualquier acto sexual sin consentimiento, que viola la integridad de una persona." },
            { text: "Violar", description: "Acto sexual forzado, constituyendo una grave agresión sexual." },
            { text: "Mutilar", description: "Causar daños permanentes o la pérdida de una parte del cuerpo." },
            { text: "Asesinar", description: "Quitar la vida a una persona, el nivel más extremo de violencia." }
        ]
    }
];
---
<section id="violentometro" class="page-section">
    <div class="container">
        <!-- VISTA 1: INFOGRAFÍA INFORMATIVA TRADICIONAL -->
        <div class="violentometro-view-info active-view" id="v-info-view">
            <h2 class="section-title">Violentómetro</h2>
            <p class="section-subtitle">Identifica las señales de violencia. Cada nivel aumenta la gravedad.</p>

            <div class="test-trigger-container">
                <button id="start-quiz-btn" class="start-quiz-action-btn">
                    <span>📊</span> ¿Tienes dudas? Realiza el Test de Concientización
                </button>
            </div>

            <div class="violentometro-grid">
                {sections.map((section) => (
                    <div class="violentometro-column" style={`--section-color: ${section.color}; --section-color-rgb: ${section.rgb};`}>
                        <div class="section-header">
                            <h3>{section.title}</h3>
                        </div>
                        <ul class="section-items">
                            {section.items.map((item) => (
                                <li class="violentometro-item" role="button" tabindex="0">
                                    <div class="item-content">
                                        <p class="item-text">{item.text}</p>
                                        <div class="item-description-wrapper">
                                            <p class="item-description">{item.description}</p>
                                        </div>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
            
            <p class="call-to-action">
                Si identificas alguna de estas situaciones, busca ayuda. No estás solo/a.
            </p>
        </div>

        <!-- VISTA 2: CUESTIONARIO INTERACTIVO (STEPPER) -->
        <div class="violentometro-view-quiz" id="v-quiz-view">
            <div class="quiz-card glass-panel-quiz">
                <div class="quiz-header">
                    <button id="back-to-info-btn" class="quiz-back-btn">← Ver infografía</button>
                    <span class="quiz-progress-text" id="quiz-progress-text">Pregunta 1 de 10</span>
                </div>
                
                <div class="quiz-progress-bar-container">
                    <div class="quiz-progress-bar-fill" id="quiz-progress-fill"></div>
                </div>

                <div class="quiz-question-container">
                    <h3 class="quiz-question" id="quiz-question-text">¿Sueles hacer chistes hirientes, burlas o apodos molestos que incomodan a la otra persona?</h3>
                    <p class="quiz-question-context" id="quiz-question-context">Nivel: Ten Cuidado (Azul)</p>
                </div>

                <div class="quiz-options">
                    <button class="quiz-option-btn" data-value="0">
                        <span class="option-check">⚪</span>
                        <span class="option-label">Nunca</span>
                    </button>
                    <button class="quiz-option-btn" data-value="1">
                        <span class="option-check">⚪</span>
                        <span class="option-label">A veces</span>
                    </button>
                    <button class="quiz-option-btn" data-value="2">
                        <span class="option-check">⚪</span>
                        <span class="option-label">Siempre</span>
                    </button>
                </div>

                <div class="quiz-navigation">
                    <button id="prev-question-btn" class="quiz-nav-btn" disabled>Anterior</button>
                    <button id="restart-quiz-btn" class="quiz-nav-btn secondary">Reiniciar</button>
                </div>
            </div>
        </div>

        <!-- VISTA 3: RESULTADOS DEL TEST -->
        <div class="violentometro-view-results" id="v-results-view">
            <div class="results-card glass-panel-quiz">
                <div class="results-header">
                    <h2>Tu Resultado</h2>
                    <p class="results-score" id="results-score-text">Puntaje: 0 / 20 puntos</p>
                </div>
                
                <div class="results-layout">
                    <!-- Termómetro visual líquido -->
                    <div class="thermometer-container">
                        <div class="thermometer-glass">
                            <div class="thermometer-fill" id="thermometer-fill"></div>
                        </div>
                        <div class="thermometer-bulb">
                            <div class="thermometer-bulb-fill" id="thermometer-bulb-fill"></div>
                        </div>
                    </div>

                    <div class="results-feedback">
                        <h3 class="results-level-title" id="results-level-title">Ten Cuidado (Azul)</h3>
                        <p class="results-description" id="results-description-text">Existen conductas sutiles de control o manipulación cotidianas que suelen normalizarse...</p>
                        
                        <div class="results-action-container">
                            <a href="/agendar" class="results-action-btn primary" id="results-action-btn">
                                <span>📅</span> Solicitar apoyo confidencial
                            </a>
                            <button id="quiz-restart-btn-final" class="results-restart-btn">Realizar Test de Nuevo</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const initViolentometro = () => {
        // --- 1. CONFIGURACIÓN DEL VIOLENTÓMETRO TRADICIONAL EXPANDIBLE ---
        const items = document.querySelectorAll('.violentometro-item');
        items.forEach(item => {
            const toggle = () => item.classList.toggle('expanded');
            
            // Remover listeners previos para evitar duplicación en Astro Views
            item.removeEventListener('click', toggle);
            item.addEventListener('click', toggle);
        });

        // --- 2. CONFIGURACIÓN DEL CUESTIONARIO INTERACTIVO ---
        const quizQuestions = [
            {
                text: "¿Sueles hacer chistes hirientes, burlas o apodos molestos que incomodan a la otra persona?",
                context: "Nivel: Ten Cuidado (Azul) - Conducta Ejercida",
                level: "azul"
            },
            {
                text: "¿Has sentido la necesidad de revisar el teléfono o las redes sociales de tu pareja/amigos sin su consentimiento?",
                context: "Nivel: Ten Cuidado (Azul) - Conducta Ejercida",
                level: "azul"
            },
            {
                text: "¿Tu pareja o amigos te prohíben vestir de cierta forma, hablar con ciertas personas o controlan tus salidas?",
                context: "Nivel: Ten Cuidado (Azul) - Conducta Recibida",
                level: "azul"
            },
            {
                text: "¿Sueles aplicar la 'ley del hielo' (ignorar y no hablarle a alguien) como una forma de castigarle o manipularle?",
                context: "Nivel: Ten Cuidado (Azul) - Conducta Ejercida",
                level: "azul"
            },
            {
                text: "¿Has sentido que te culpabilizan de todos los problemas de la relación, haciéndote dudar de ti mismo/a?",
                context: "Nivel: Ten Cuidado (Azul) - Conducta Recibida",
                level: "azul"
            },
            {
                text: "¿Ha habido golpes 'jugando', empujones, pellizcos o jaloneos físicos durante discusiones o momentos de tensión?",
                context: "Nivel: Reacciona (Rojo) - Conducta Dual",
                level: "rojo"
            },
            {
                text: "¿Te han prohibido o aislado de tus familiares y amigos cercanos para que pases tiempo únicamente con esa persona?",
                context: "Nivel: Reacciona (Rojo) - Conducta Recibida",
                level: "rojo"
            },
            {
                text: "¿Te han amenazado alguna vez con destruirte, con quitarse la vida o con hacerte daño físico a ti o a tus seres queridos?",
                context: "Nivel: Reacciona/Actúa - Alerta Crítica",
                level: "rojo"
            },
            {
                text: "¿Te has sentido forzado/a o presionado/a a mantener contacto o relaciones sexuales por temor a enfadar a tu pareja?",
                context: "Nivel: Actúa (Púrpura) - Peligro Crítico",
                level: "purpura"
            },
            {
                text: "¿Alguna vez has destruido, tirado o dañado pertenencias, objetos personales o regalos de otra persona por enojo?",
                context: "Nivel: Reacciona (Rojo) - Conducta Ejercida",
                level: "rojo"
            }
        ];

        let currentQuestionIdx = 0;
        let answers = Array(quizQuestions.length).fill(null);

        // Elementos DOM de Vistas
        const infoView = document.getElementById('v-info-view');
        const quizView = document.getElementById('v-quiz-view');
        const resultsView = document.getElementById('v-results-view');

        // Elementos DOM del Cuestionario
        const questionText = document.getElementById('quiz-question-text');
        const questionContext = document.getElementById('quiz-question-context');
        const progressText = document.getElementById('quiz-progress-text');
        const progressFill = document.getElementById('quiz-progress-fill');
        const optionButtons = document.querySelectorAll('.quiz-option-btn');
        const prevBtn = document.getElementById('prev-question-btn');
        const restartBtn = document.getElementById('restart-quiz-btn');
        
        // Elementos DOM de Resultados
        const resultsScore = document.getElementById('results-score-text');
        const levelTitle = document.getElementById('results-level-title');
        const descriptionText = document.getElementById('results-description-text');
        const thermometerFill = document.getElementById('thermometer-fill');
        const thermometerBulbFill = document.getElementById('thermometer-bulb-fill');
        const actionBtn = document.getElementById('results-action-btn') as HTMLAnchorElement;

        // Botones de Navegación de Vistas
        const startQuizBtn = document.getElementById('start-quiz-btn');
        const backToInfoBtn = document.getElementById('back-to-info-btn');
        const restartQuizBtnFinal = document.getElementById('quiz-restart-btn-final');

        if (!infoView || !quizView || !resultsView) return;

        // Alternar vistas
        const showView = (viewName: 'info' | 'quiz' | 'results') => {
            infoView.classList.remove('active-view');
            quizView.classList.remove('active-view');
            resultsView.classList.remove('active-view');

            if (viewName === 'info') infoView.classList.add('active-view');
            if (viewName === 'quiz') quizView.classList.add('active-view');
            if (viewName === 'results') resultsView.classList.add('active-view');
        };

        const updateQuestionUI = () => {
            if (!questionText || !questionContext || !progressText || !progressFill || !prevBtn) return;

            const currentQuestion = quizQuestions[currentQuestionIdx];
            questionText.textContent = currentQuestion.text;
            questionContext.textContent = currentQuestion.context;

            // Ajustar el color del tag de contexto según el nivel de la pregunta
            questionContext.className = 'quiz-question-context ' + currentQuestion.level;

            progressText.textContent = `Pregunta ${currentQuestionIdx + 1} de ${quizQuestions.length}`;
            const percentage = ((currentQuestionIdx) / quizQuestions.length) * 100;
            progressFill.style.width = `${percentage}%`;

            // Resetear estados de botones de opción
            optionButtons.forEach(btn => {
                btn.classList.remove('selected');
                const check = btn.querySelector('.option-check');
                if (check) check.textContent = '⚪';
            });

            // Seleccionar respuesta previa si existe
            const prevAnswer = answers[currentQuestionIdx];
            if (prevAnswer !== null) {
                const selectedBtn = document.querySelector(`.quiz-option-btn[data-value="${prevAnswer}"]`);
                if (selectedBtn) {
                    selectedBtn.classList.add('selected');
                    const check = selectedBtn.querySelector('.option-check');
                    if (check) check.textContent = '🟢';
                }
            }

            // Deshabilitar botón Anterior si estamos al principio
            prevBtn.disabled = currentQuestionIdx === 0;
        };

        const handleOptionClick = (value: number) => {
            answers[currentQuestionIdx] = value;

            // Actualizar UI del botón seleccionado
            optionButtons.forEach(btn => {
                const check = btn.querySelector('.option-check');
                if (btn.getAttribute('data-mood') || btn.getAttribute('data-value') === value.toString()) {
                    btn.classList.add('selected');
                    if (check) check.textContent = '🟢';
                } else {
                    btn.classList.remove('selected');
                    if (check) check.textContent = '⚪';
                }
            });

            // Avanzar a la siguiente pregunta después de un retraso mínimo
            setTimeout(() => {
                if (currentQuestionIdx < quizQuestions.length - 1) {
                    currentQuestionIdx++;
                    updateQuestionUI();
                } else {
                    // Completado: Calcular resultado
                    showResults();
                }
            }, 250);
        };

        const showResults = () => {
            if (!resultsScore || !levelTitle || !descriptionText || !thermometerFill || !thermometerBulbFill) return;

            const totalScore = answers.reduce((sum, val) => sum + (val || 0), 0);
            resultsScore.textContent = `Puntaje: ${totalScore} / 20 puntos`;

            let level = '';
            let description = '';
            let color = '';
            let priorityParam = 'normal';

            if (totalScore <= 4) {
                level = 'Ten Cuidado (Azul)';
                color = '#1e90ff';
                description = 'Existen conductas sutiles de control, celos o bromas hirientes cotidianas que suelen normalizarse en las relaciones. Aunque parezcan inofensivas, son señales de alerta iniciales. Es momento de reflexionar sobre la forma en que nos comunicamos y poner límites sanos a tiempo.';
                priorityParam = 'low';
            } else if (totalScore <= 10) {
                level = 'Reacciona (Rojo)';
                color = '#dc3545';
                description = '¡Cuidado! Se identifican agresiones físicas (golpes "jugando", empujones) o de control directo (aislamiento, prohibiciones). Estas conductas no son normales ni forman parte de una relación saludable. Te recomendamos acercarte al departamento de Psicopedagogía para recibir apoyo confidencial.';
                priorityParam = 'medium';
            } else {
                level = 'Actúa (Púrpura)';
                color = '#6f42c1';
                description = '¡Peligro crítico! Tu relación o tus actitudes presentan niveles alarmantes de violencia extrema, manipulación o coacción sexual/física. Tu integridad física y psicológica están en riesgo. No estás solo/a; busca ayuda profesional confidencial de forma urgente.';
                priorityParam = 'high';
            }

            levelTitle.textContent = level;
            levelTitle.style.color = color;
            descriptionText.textContent = description;

            // Ajustar url de cita con prioridad confidencial
            if (actionBtn) {
                actionBtn.href = `/agendar?priority=${priorityParam}&from=quiz`;
            }

            showView('results');

            // Animar el termómetro líquido
            setTimeout(() => {
                const fillPercentage = Math.max((totalScore / 20) * 100, 5); // Al menos 5% para que se vea el líquido
                thermometerFill.style.height = `${fillPercentage}%`;
                thermometerFill.style.backgroundColor = color;
                thermometerBulbFill.style.backgroundColor = color;
            }, 100);
        };

        const resetQuiz = () => {
            currentQuestionIdx = 0;
            answers = Array(quizQuestions.length).fill(null);
            if (thermometerFill) thermometerFill.style.height = '0%';
            updateQuestionUI();
            showView('quiz');
        };

        // --- REGISTRO DE EVENTOS ---
        if (startQuizBtn) {
            startQuizBtn.addEventListener('click', () => {
                resetQuiz();
            });
        }

        if (backToInfoBtn) {
            backToInfoBtn.addEventListener('click', () => {
                showView('info');
            });
        }

        if (restartQuizBtnFinal) {
            restartQuizBtnFinal.addEventListener('click', () => {
                resetQuiz();
            });
        }

        optionButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const val = parseInt(btn.getAttribute('data-value') || '0');
                handleOptionClick(val);
            });
        });

        if (prevBtn) {
            prevBtn.addEventListener('click', () => {
                if (currentQuestionIdx > 0) {
                    currentQuestionIdx--;
                    updateQuestionUI();
                }
            });
        }

        if (restartBtn) {
            restartBtn.addEventListener('click', () => {
                if (confirm('¿Seguro que deseas reiniciar el test?')) {
                    resetQuiz();
                }
            });
        }
    };

    // Inicializar
    document.addEventListener('DOMContentLoaded', initViolentometro);
    document.addEventListener('astro:after-swap', initViolentometro);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initViolentometro();
    }
</script>

<style>
    .page-section {
        width: 100%;
        max-width: 1200px;
        padding: 4rem 2rem;
        box-sizing: border-box;
        text-align: center;
        border-bottom: 1px solid var(--navbar-border);
        background-color: transparent; /* Permite ver las partículas globales */
        position: relative;
    }

    .container {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
    }

    .section-title {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--heading-color);
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        scroll-margin-top: 100px;
    }

    .section-subtitle {
        color: var(--body-text-color);
        margin-bottom: 2rem;
        font-size: 1.05rem;
        line-height: 1.5;
    }

    /* --- VISTAS INTERACTIVAS (TRANSICIONES) --- */
    .violentometro-view-info,
    .violentometro-view-quiz,
    .violentometro-view-results {
        display: none;
        opacity: 0;
        transform: translateY(15px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .violentometro-view-info.active-view,
    .violentometro-view-quiz.active-view,
    .violentometro-view-results.active-view {
        display: block;
        opacity: 1;
        transform: translateY(0);
    }

    /* Contenedor de Botón de Test */
    .test-trigger-container {
        margin-bottom: 2.5rem;
        display: flex;
        justify-content: center;
    }

    .start-quiz-action-btn {
        background: rgba(162, 217, 206, 0.12);
        border: 1px solid rgba(162, 217, 206, 0.4);
        color: var(--heading-color);
        padding: 12px 28px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer !important;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(162, 217, 206, 0.05);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .start-quiz-action-btn:hover {
        transform: translateY(-2px);
        background: rgba(162, 217, 206, 0.2);
        box-shadow: 0 6px 20px rgba(162, 217, 206, 0.15);
        border-color: #A2D9CE;
    }

    /* --- GRID DEL VIOLENTÓMETRO TRADICIONAL --- */
    .violentometro-grid {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
        justify-content: center;
    }

    .violentometro-column {
        flex: 1;
        background-color: var(--card-bg);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.03);
        display: flex;
        flex-direction: column;
        border: 1px solid var(--navbar-border);
        transition: all 0.3s ease;
    }

    .violentometro-column:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.06);
    }

    .section-header {
        background-color: var(--section-color);
        color: white;
        padding: 1.2rem;
        text-align: center;
    }

    .section-header h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: white;
    }

    .section-items {
        list-style: none;
        padding: 1rem;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .violentometro-item {
        background-color: rgba(var(--section-color-rgb), 0.05);
        padding: 0.8rem 1rem;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        text-align: left;
        border: 1px solid rgba(var(--section-color-rgb), 0.08);
    }

    .violentometro-item:hover {
        background-color: rgba(var(--section-color-rgb), 0.12);
        transform: translateX(5px);
        border-color: rgba(var(--section-color-rgb), 0.25);
    }

    .item-text {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-color);
        line-height: 1.35;
    }

    .item-description-wrapper {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .violentometro-item.expanded .item-description-wrapper {
        max-height: 120px;
        margin-top: 0.6rem;
    }

    .item-description {
        font-size: 0.8rem;
        color: var(--body-text-color);
        margin: 0;
        line-height: 1.45;
        border-top: 1px dashed rgba(var(--section-color-rgb), 0.25);
        padding-top: 0.5rem;
